{
  "name": "in-rainbows-theme",
  "displayName": "In Rainbows Theme",
  "description": "A VS Code theme inspired by the critically and publicly aclaimed album 'In Rainbows' by Radiohead.",
  "version": "1.0.0",
  "icon": "in-rainbows.png",
  "publisher": "joaostephan",
  "license": "UNLICENSED",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stephanjoao/in-rainbows-theme.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "in rainbows",
    "radiohead"
  ],
  "scripts": {
    "validate": "node scripts/validate-theme.mjs",
    "vscode:prepublish": "npm run validate"
  },
  "contributes": {
    "themes": [
      {
        "label": "In Rainbows Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      },
      {
        "label": "In Rainbows Light",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      }
    ]
  }
}
